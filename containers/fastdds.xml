<?xml version="1.0" encoding="UTF-8"?>
<!-- Separate rootless invocations have private /dev/shm; use UDP between them. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>d1_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="d1_udp_participant" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>d1_udp</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
